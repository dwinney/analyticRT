    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<\!\(\*SqrtBox[SubscriptBox[\(s\), \(p\)]]\) = (\>\"", ",", " ", 
       RowBox[{
        SqrtBox["sp"], "*", 
        SuperscriptBox["10", "3"]}], ",", " ", "\"\<) MeV\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<M = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"Re", "[", 
         SqrtBox["sp"], "]"}], "*", 
        SuperscriptBox["10", "3"]}], ",", " ", "\"\< MeV\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[CapitalGamma] = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], 
        RowBox[{"Im", "[", 
         SqrtBox["sp"], "]"}], "*", 
        SuperscriptBox["10", "3"]}], ",", " ", "\"\< MeV\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gi", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"gi", ",", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NLimit", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "16"}], "\[Pi]", " ", 
            RowBox[{"f", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{"s", "-", "sp"}], ")"}], 
            FractionBox["3", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"2", 
                RowBox[{"q", "[", "s", "]"}]}], ")"}], "2"]]}], ",", 
           RowBox[{"s", "->", "sp"}], ",", 
           RowBox[{"WorkingPrecision", "\[Rule]", "50"}], ",", " ", 
           RowBox[{"Direction", "\[Rule]", "1"}], ",", 
           RowBox[{"Method", "->", "\"\<SequenceLimit\>\""}]}], "]"}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"gi", ",", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NLimit", "[", 
          RowBox[{
