Cell[BoxData[{
 RowBox[{
  RowBox[{"generateCoeffs", "[", 
   RowBox[{"svals_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "N", ",", "i", ",", "current", ",", "next", ",", " ", "last", ",", " ", 
      "as", ",", "fvals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Set", " ", "up", " ", "vector", " ", "of", " ", "f", 
      RowBox[{"(", "s", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"N", "=", 
      RowBox[{"Length", "[", "svals", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fvals", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"fvals", ",", 
         RowBox[{"f", "[", 
          RowBox[{"svals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "svals", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "empty", " ", "list", " ", "to", " ", "output", " ", "resulting", " ", 
       "coeffs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "coefficient"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"as", ",", 
       RowBox[{
        FractionBox["1.", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"svals", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"svals", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}]], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"fvals", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           RowBox[{"fvals", "[", 
            RowBox[{"[", "2", "]"}], "]"}]], "-", "1"}], ")"}]}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"loop", " ", "over", " ", "i"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"2", " ", "to", " ", "N"}], "-", 
        RowBox[{"1", " ", "coefficients"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"last", " ", "=", " ", "0"}], ";", " ", 
        RowBox[{"current", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"last", "=", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"as", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"svals", "[", 
              RowBox[{"[", 
               RowBox[{"l", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"svals", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], 
          RowBox[{"1.", "-", 
           RowBox[{
            RowBox[{"fvals", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", 
            RowBox[{"fvals", "[", 
             RowBox[{"[", 
              RowBox[{"l", "+", "1"}], "]"}], "]"}]}]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"current", " ", "=", " ", "last"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"current", " ", "=", " ", 
            FractionBox[
             RowBox[{
              RowBox[{"as", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"svals", "[", 
                 RowBox[{"[", 
                  RowBox[{"l", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"svals", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], 
             RowBox[{"1.", "+", "last"}]]}], ";", "\[IndentingNewLine]", 
           RowBox[{"last", " ", "=", " ", "current"}], ";"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "2", ",", 
            RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"as", ",", " ", 
          FractionBox[
           RowBox[{"1", "+", "current"}], 
           RowBox[{
            RowBox[{"svals", "[", 
             RowBox[{"[", "l", "]"}], "]"}], "-", 
            RowBox[{"svals", "[", 
             RowBox[{"[", 
              RowBox[{"l", "+", "1"}], "]"}], "]"}]}]]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
