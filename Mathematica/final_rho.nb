           RowBox[{"Direction", "\[Rule]", 
            RowBox[{"-", "1"}]}], ",", 
           RowBox[{"Method", "->", "\"\<SequenceLimit\>\""}]}], "]"}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"gi", ",", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NLimit", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "16"}], "\[Pi]", " ", 
            RowBox[{"f", "[", "s", "]"}], 
            RowBox[{"(", 
