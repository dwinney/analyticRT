Cell[CellGroupData[{

Cell["On the unphysical sheet", "Subsection",
 CellChangeTimes->{{3.9328182851964383`*^9, 
  3.9328182901765633`*^9}},ExpressionUUID->"911c8050-508a-46ad-a6c9-\
26c588be2e66"],

Cell["\<\
The second sheet is stitched to the first by the discontinuity\
\>", "Text",
 CellChangeTimes->{{3.9330889472753882`*^9, 
  3.933088956514162*^9}},ExpressionUUID->"afab4f67-fc75-462f-b342-\
ffa925d68475"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", 
              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", 
                 RowBox[{"--", 
                  RowBox[{"--", 
                   RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", "-"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dispIntII", "[", "s_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      FractionBox["s", "\[Pi]"], 
      RowBox[{"Quiet", "@", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"Im\[Alpha]", "[", "x", "]"}], "-", 
           RowBox[{"Im\[Alpha]", "[", "s", "]"}]}], 
          RowBox[{"x", 
           RowBox[{"(", 
            RowBox[{"x", "-", "s", "+", "i\[Epsilon]"}], ")"}]}]], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"4", 
