Cell[CellGroupData[{

Cell["On the first sheet", "Subsection",
 CellChangeTimes->{{3.932818240689942*^9, 
  3.932818242600189*^9}},ExpressionUUID->"53c3eb7f-6675-47eb-88f9-\
660fc254624d"],

Cell["\<\
Define the dispersion integral without an i\[Epsilon] prescription, remember \
to put it in by hand in the argument!\
\>", "Text",
 CellChangeTimes->{{3.9330885949542656`*^9, 
  3.933088619236287*^9}},ExpressionUUID->"65fbf463-60bf-4530-952b-\
b4d9193a2f15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispIntI", "[", "s_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["s", "\[Pi]"], 
    RowBox[{"Quiet", "@", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"Im\[Alpha]", "[", "x", "]"}], "-", 
         RowBox[{"Im\[Alpha]", "[", "s", "]"}]}], 
        RowBox[{"x", 
         RowBox[{"(", 
          RowBox[{"x", "-", "s", "-", "i\[Epsilon]"}], ")"}]}]], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"4", 
          SuperscriptBox["m", "2"]}], ",", "\[Infinity]"}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}], ",", 
       RowBox[{"MaxRecursion", "\[Rule]", "20"}]}], "]"}]}]}], "-", 
   RowBox[{
    FractionBox[
     RowBox[{"Im\[Alpha]", "[", "s", "]"}], "\[Pi]"], 
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"s", "+", "i\[Epsilon]"}], 
       RowBox[{"4", 
        SuperscriptBox["m", "2"]}]]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]I", "[", "s_", "]"}], ":=", 
  RowBox[{"\[Alpha]0", " ", "+", " ", 
   RowBox[{"dispIntI", "[", "s", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.932801140199121*^9, 3.9328012232368407`*^9}, {
   3.932801280533862*^9, 3.9328014512810545`*^9}, {3.9328015623484216`*^9, 
   3.932801623093653*^9}, 3.9328017873467073`*^9, {3.932801898070586*^9, 
