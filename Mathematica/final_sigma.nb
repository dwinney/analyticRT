Cell[CellGroupData[{

Cell["On the first sheet", "Subsection",
 CellChangeTimes->{{3.932818240689942*^9, 
  3.932818242600189*^9}},ExpressionUUID->"53c3eb7f-6675-47eb-88f9-\
660fc254624d"],

Cell["\<\
Define the dispersion integral without an i\[Epsilon] prescription, remember \
to put it in by hand in the argument!\
\>", "Text",
 CellChangeTimes->{{3.9330885949542656`*^9, 
  3.933088619236287*^9}},ExpressionUUID->"65fbf463-60bf-4530-952b-\
b4d9193a2f15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispInt", "[", "s_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["s", "\[Pi]"], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"Im\[Alpha]", "[", "x", "]"}], "-", 
        RowBox[{"Im\[Alpha]", "[", "s", "]"}]}], 
       RowBox[{"x", 
        RowBox[{"(", 
         RowBox[{"x", "-", "s"}], ")"}]}]], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"4", 
         SuperscriptBox["m", "2"]}], ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", 
         RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
     "]"}]}], "-", 
   RowBox[{
    FractionBox[
     RowBox[{"Im\[Alpha]", "[", "s", "]"}], "\[Pi]"], 
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", 
      FractionBox["s", 
       RowBox[{"4", 
        SuperscriptBox["m", "2"]}]]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dispth", " ", "=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{"dispInt", "[", 
     RowBox[{
      RowBox[{"4", 
       SuperscriptBox["m", "2"]}], " ", "+", " ", 
      RowBox[{"I", " ", "\[Epsilon]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]I", "[", "s_", "]"}], ":=", 
  RowBox[{"\[Alpha]th", " ", "+", " ", 
   RowBox[{"dispInt", "[", "s", "]"}], "-", 
   "dispth"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fI", "[", "s_", "]"}], ":=", 
  RowBox[{
   FractionBox["g\[Sigma]", 
    RowBox[{"-", 
     RowBox[{"\[Alpha]I", "[", "s", "]"}]}]], "-", "gP"}]}]}], "Input",
 CellChangeTimes->{{3.932801140199121*^9, 3.9328012232368407`*^9}, {
