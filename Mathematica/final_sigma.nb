Cell[CellGroupData[{

Cell["Continued Fractions definitions", "Subsubsection",
 CellChangeTimes->{{3.9330891000217934`*^9, 3.93308910513437*^9}, {
  3.9331589602375927`*^9, 3.933158962031141*^9}, {3.9331746001934586`*^9, 
  3.9331746055261517`*^9}, {3.9332416007411156`*^9, 
  3.933241621264701*^9}},ExpressionUUID->"090c83bf-8cb2-4e87-b923-\
77fd7e5b6e85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"generateCoeffs", "[", 
   RowBox[{"svals_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "N", ",", "i", ",", "current", ",", "next", ",", " ", "last", ",", " ", 
      "as", ",", "fvals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Set", " ", "up", " ", "vector", " ", "of", " ", "f", 
      RowBox[{"(", "s", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"N", "=", 
      RowBox[{"Length", "[", "svals", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fvals", "=", 
      RowBox[{"f", "[", "svals", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "empty", " ", "list", " ", "to", " ", "output", " ", "resulting", " ", 
       "coeffs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "coefficient"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"as", ",", 
       RowBox[{
        FractionBox["1.", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"svals", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"svals", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}]], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"fvals", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           RowBox[{"fvals", "[", 
            RowBox[{"[", "2", "]"}], "]"}]], "-", "1"}], ")"}]}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"loop", " ", "over", " ", "i"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"2", " ", "to", " ", "N"}], "-", 
        RowBox[{"1", " ", "coefficients"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"last", " ", "=", " ", "0"}], ";", " ", 
        RowBox[{"current", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"last", "=", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"as", "[", 
            RowBox[{"[", "1", "]"}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"svals", "[", 
              RowBox[{"[", 
               RowBox[{"l", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"svals", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], 
          RowBox[{"1.", "-", 
           RowBox[{
            RowBox[{"fvals", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", 
            RowBox[{"fvals", "[", 
             RowBox[{"[", 
              RowBox[{"l", "+", "1"}], "]"}], "]"}]}]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"current", " ", "=", " ", "last"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"current", " ", "=", " ", 
            FractionBox[
             RowBox[{
              RowBox[{"as", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"svals", "[", 
                 RowBox[{"[", 
                  RowBox[{"l", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"svals", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], 
             RowBox[{"1.", "+", "last"}]]}], ";", "\[IndentingNewLine]", 
           RowBox[{"last", " ", "=", " ", "current"}], ";"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "2", ",", 
            RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"as", ",", " ", 
          FractionBox[
