Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s0", "=", "0.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nPade", " ", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PadeApproximant", "[", 
   RowBox[{
    RowBox[{"Im\[Alpha]", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "s0", ",", "nPade"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Im\[Alpha]Pade", "[", "x_", "]"}], "=", "%"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]Pade", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]I", "[", 
     RowBox[{"x", "-", "i\[Epsilon]"}], "]"}], "+", " ", 
    RowBox[{"2", " ", "I", "  ", 
     RowBox[{"Im\[Alpha]Pade", "[", "x", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fPade", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["g\[Sigma]", 
     RowBox[{"-", 
      RowBox[{"\[Alpha]Pade", "[", 
       RowBox[{"x", "-", "i\[Epsilon]"}], "]"}]}]], "-", "gP"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"fPade", "[", 
     RowBox[{"x", "+", 
      RowBox[{"I", " ", "y"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"+", "\[Epsilon]"}], ",", "0.1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "0.7"}], ",", 
     RowBox[{"-", "\[Epsilon]"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"frameLabel", "[", "\"\<Re s\>\"", "]"}], ",", " ", 
      RowBox[{"frameLabel", "[", "\"\<Im s\>\"", "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "30"}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"pole", "=", 
  RowBox[{"Quiet", "@", 
   RowBox[{"PoleSearch", "[", 
    RowBox[{"fPade", ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", "0.5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", 
       RowBox[{"-", "\[Epsilon]"}]}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ResParams", "[", 
  RowBox[{"fPade", ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", 
      RowBox[{"I", " ", "y"}]}], ")"}], "/.", 
    RowBox[{"pole", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "Input",
